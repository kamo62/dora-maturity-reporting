# Copy to .env and replace placeholders locally. Never commit credentials.
# Required only for authorised Azure DevOps collection.
ADO_AZURE_DEVOPS_PAT=YOUR_AZURE_DEVOPS_PAT_HERE
ADO_AZURE_DEVOPS_ORG=YOUR_AZURE_DEVOPS_ORGANISATION_HERE
ADO_LOG_LEVEL=INFO
ADO_RUN_ENV=local

# Optional for the API. Some local endpoints bypass API-key checks.
ADO_API_KEY=
ADO_EXEMPTIONS_FILE=src/devops_metrics/config/exemptions.yaml

# Leave empty for file-only operation. See README.md for DB setup.
DATABASE_URL=
DISABLE_TIMESCALE_FEATURES=false

# Optional Docker Compose stack. Set fresh, URL-safe passwords before starting it.
POSTGRES_PASSWORD=
GRAFANA_USER=YOUR_GRAFANA_USERNAME_HERE
GRAFANA_PASSWORD=
