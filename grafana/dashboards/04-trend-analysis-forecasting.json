{
  "uid": "trend-analysis",
  "title": "Trend Analysis",
  "tags": ["devops-metrics"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Runs per Day",
      "id": 1,
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "DevOps Metrics DB" },
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT time_bucket('1 day', COALESCE(finished_at, started_at)) AS time, COUNT(*) AS runs FROM runs WHERE $__timeFilter(COALESCE(finished_at, started_at)) GROUP BY time ORDER BY time;",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    }
  ]
}

