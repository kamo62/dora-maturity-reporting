{
  "uid": "exec-overview",
  "title": "Executive Overview",
  "tags": ["devops-metrics"],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Total Runs",
      "id": 1,
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "DevOps Metrics DB" },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS total_runs FROM runs;",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Avg Run Duration (min)",
      "id": 2,
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "postgres", "uid": "DevOps Metrics DB" },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT ROUND(AVG(EXTRACT(EPOCH FROM (finished_at - started_at))) / 60.0, 1) AS avg_minutes FROM runs WHERE finished_at IS NOT NULL;",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "min" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Runs per Day",
      "id": 3,
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "postgres", "uid": "DevOps Metrics DB" },
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT time_bucket('1 day', COALESCE(finished_at, started_at)) AS time, COUNT(*) AS runs FROM runs WHERE $__timeFilter(COALESCE(finished_at, started_at)) GROUP BY time ORDER BY time;",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    }
  ]
}

